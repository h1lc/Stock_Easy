DATABASE_URL="postgresql://stockeasy:stockeasy_password@localhost:5432/stockeasy_db"
JWT_SECRET="change-this-to-a-very-long-random-secret-in-production"
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google OAuth (optionnel — obtenir sur console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
