DATABASE_URL="postgresql://stockeasy:stockeasy_password@localhost:5432/stockeasy_db"
JWT_SECRET="change-this-to-a-very-long-random-secret-in-production"
PORT=3000
NODE_ENV=development
# En mode Docker : http://localhost:8081 — en dev local (Vite) : http://localhost:5173
CLIENT_URL=http://localhost:8081

# Google OAuth (optionnel — obtenir sur console.cloud.google.com)
# L'URI ci-dessous doit etre declaree a l'identique dans la console Google.
# Mode Docker : port 8081 (Nginx proxifie /api vers le serveur).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8081/api/auth/google/callback

# SMTP pour les emails de reinitialisation (optionnel — affiche dans la console si absent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockEasy <noreply@dupont-fils.fr>"
